openapi: 3.0.3
info:
  title: RingCentral Emergency Locations API
  description: API for Emergency Locations
  contact:
    name: RingCentral Connect Platform
    url: http://developers.ringcentral.com
    email: platform@ringcentral.com
  license:
    name: RingCentral API License Agreement and Terms of Use
    url: https://www.ringcentral.com/legal/apilitos.html
  version: 1.0.40
servers:
  - url: https://platform.ringcentral.com

x-auth-required: true
x-auth-context-type: User
x-service-version: "v1"
x-service-interface: "rest"
x-service-name: "pas"
x-internal-api: false
x-failover-strategy: "Hardening"
x-blacklisting-strategy: "Hardening"
x-balancing-method: "ConsistentHashByHeader"
x-availability: "Limited"
x-team: Platform IPA
x-docs-level: Internal

tags:
- name: Automatic Location Updates

paths:
  /restapi/v1.0/account/{accountId}/emergency-locations:
    get:
      tags:
        - Automatic Location Updates
      summary: List Emergency Locations
      description: Returns emergency response locations for the current account.
      operationId: listEmergencyLocations
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '#/components/parameters/SiteIdQuery'
        - name: searchString
          in: query
          description: |
            Filters entries containing the specified substring in 'address'
            and 'name' fields. The character range is 0-64; not case-sensitive.
            If empty then the filter is ignored
          schema:
            type: string
            maxLength: 64
        - name: addressStatus
          in: query
          description: |
            Status of emergency address to filter results by
          schema:
            $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyAddressStatus'
        - name: usageStatus
          in: query
          description: |
            Status of emergency location to filter results by
          schema:
            $ref: '#/components/schemas/EmergencyLocationUsageStatus'
        - name: domesticCountryId
          in: query
          description: |
            Domestic country ID to filter results by
          schema:
            type: string
        - name: orderBy
          in: query
          description: |
            Comma-separated list of fields to order results, prefixed by
            plus sign '+' (ascending order) or minus sign '-' (descending order)
          schema:
            type: string
            enum:
            - '+name'
            - '+siteName'
            - '+address'
            - '+addressStatus'
            - '+usageStatus'
            - '-name'
            - '-siteName'
            - '-address'
            - '-addressStatus'
            - '-usageStatus'
            default: '+address'
        - name: visibility
          in: query
          description: Visibility of emergency location to filter results by
          schema:
            type: string
            enum:
              - Public
            default: Public
        - name: perPage
          in: query
          description: |
            Indicates a page size (number of items). The values
            supported: `Max` or numeric value. If not specified,
            100 records are returned per one page
          schema:
            type: integer
            format: int32
            default: 100
        - name: page
          in: query
          description: |
            Indicates the page number to retrieve. Only positive number values
            are supported
          schema:
            type: integer
            format: int32
            default: 1
      responses:
        "200":
          description: Emergency locations list
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EmergencyLocationsResource'
      
      x-app-permission: "ReadAccounts"
      x-user-permission: "ConfigureEmergencyMaps"
      x-throttling-group: "Light"
      x-availability: "High"
      x-docs-level: Public
      x-beta-api: true
      x-feature: ReadCompanyInfo
    post:
      tags:
        - Automatic Location Updates
      summary: Add Emergency Location
      operationId: createEmergencyLocation
      description: Creates a new emergency response location for a company.
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
      requestBody:
        description: JSON body
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmergencyLocationRequestResource'
        required: true
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyLocationResponseResource'
        "409":
          $ref: '../common/error-responses-oaf.yml#/components/responses/Conflict'
      
      x-app-permission: "EditAccounts"
      x-user-permission: "ConfigureEmergencyMaps"
      x-throttling-group: "Medium"
      x-feature: EditSoftPhoneAutoLocationUpdate OR EditHardPhoneAutoLocationUpdate
      x-docs-level: Public
      x-beta-api: true

  /restapi/v1.0/account/{accountId}/emergency-locations/{locationId}:
    get:
      tags:
        - Automatic Location Updates
      summary: Get Emergency Location
      description: Returns emergency response location by ID. Available for Admin users only.
      operationId: readEmergencyLocation
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '#/components/parameters/EmergencyLocationId'
        - name: syncEmergencyAddress
          in: query
          description: |
            If true, the emergency addresses will be synchronized with the
            external provider data
          schema:
            type: boolean
      responses:
        "200":
          description: Emergency location information
          content:
            application/json:
              schema:
                $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/CommonEmergencyLocationResource'
      
      x-app-permission: "EditAccounts"
      x-user-permission: "ConfigureEmergencyMaps"
      x-feature: EditSoftPhoneAutoLocationUpdate OR EditHardPhoneAutoLocationUpdate OR ReadEmergencyLocations
      x-throttling-group: "Light"
      x-docs-level: Public
      x-beta-api: true
    put:
      tags:
        - Automatic Location Updates
      summary: Update Emergency Location
      description: Updates the specified emergency response location.
      operationId: updateEmergencyLocation
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '#/components/parameters/EmergencyLocationId'
      requestBody:
        description: JSON body
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmergencyLocationRequestResource'
        required: true
      responses:
        "200":
          description: Updated emergency location information
          content:
            application/json:
              schema:
                $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyLocationResponseResource'
      
      x-app-permission: "EditAccounts"
      x-user-permission: "ConfigureEmergencyMaps"
      x-feature: EditSoftPhoneAutoLocationUpdate OR EditHardPhoneAutoLocationUpdate OR EditEmergencyLocations
      x-throttling-group: "Heavy"
      x-docs-level: Public
      x-beta-api: true
    delete:
      tags:
        - Automatic Location Updates
      operationId: deleteEmergencyLocation
      summary: Delete Emergency Location
      description: Deletes the specified emergency response location.
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '#/components/parameters/EmergencyLocationId'
        - name: validateOnly
          in: query
          description: |
            Flag indicating that validation of emergency location(s) is required
            before deletion
          required: false
          schema:
            type: boolean
        - name: newLocationId
          in: query
          description: |
            Internal identifier of an emergency response location
            that should be used instead of a deleted one.
          required: false
          schema:
            type: string
      responses:
        "200":
          description: Successful validation
        "204":
          description: No content
        "207":
          description: Multi-status
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetLocationDeletionMultiResponse'
      
      x-app-permission: "EditAccounts"
      x-user-permission: "ConfigureEmergencyMaps"
      x-throttling-group: "Heavy"
      x-feature: EditEmergencyLocations
      x-docs-level: Public

  /restapi/v1.0/account/{accountId}/extension/{extensionId}/emergency-locations:
    get:
      tags:
        - Automatic Location Updates
      summary: List User Emergency Locations
      description: Returns a list of emergency response locations available for the particular
        extension.
      operationId: getExtensionEmergencyLocations
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '../common/common-params-oaf.yml#/components/parameters/ExtensionId'
        - $ref: '#/components/parameters/SiteIdQuery'
        - name: searchString
          in: query
          description: |
            Filters entries by the specified substring (search by chassis
            ID, switch name or address) The characters range is 0-64 (if
            empty the filter is ignored)
          schema:
            type: string
        - name: domesticCountryId
          in: query
          description: |
            Domestic country ID to filter results by
          schema:
            type: string
        - name: orderBy
          in: query
          description: |
            Comma-separated list of fields to order results prefixed by '+'
            sign (ascending order) or '-' sign (descending order). The default
            sorting is by `name`
          schema:
            type: string
            default: "+visibility"
            enum:
            - +name
            - +siteName
            - +address
            - +addressStatus
            - +usageStatus
            - +visibility
            - -name
            - -siteName
            - -address
            - -addressStatus
            - -usageStatus
            - -visibility
        - name: perPage
          in: query
          description: |
            Indicates a page size (number of items). The values supported:
            `Max` or numeric value. If not specified, 100 records are returned
            per one page
          schema:
            format: int32
            type: integer
        - name: page
          in: query
          description: |
            Indicates a page number to retrieve. Only positive
            number values are supported
          schema:
            type: integer
            default: 1
            format: int32
        - name: visibility
          in: query
          description: |
            Visibility of emergency location to filter results by
          schema:
            type: string
            enum:
              - Public
            default: Public
      responses:
        "200":
          description: User emergency location list
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EmergencyLocationsResource'
      
      x-app-permission: "ReadAccounts"
      x-throttling-group: "Light"
      x-availability: "High"
      x-docs-level: Public
    post:
      tags:
        - Automatic Location Updates
      summary: Create User Emergency Location
      description: Creates a personal emergency response location for the current user.
      operationId: createExtensionEmergencyLocation
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '../common/common-params-oaf.yml#/components/parameters/ExtensionId'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateUserEmergencyLocationRequest'
        required: true
      responses:
        "200":
          description: Emergency location information
          content:
            application/json:
              schema:
                $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyLocationResponseResource'
      
      x-docs-level: Public
      x-app-permission: "EditAccounts"
      x-user-permission: EmergencyFramework
      x-feature: EmergencyFramework or NewEmergencyCallingFramework
      x-throttling-group: "Heavy"

  /restapi/v1.0/account/{accountId}/extension/{extensionId}/emergency-locations/{locationId}:
    put:
      tags:
        - Automatic Location Updates
      summary: Update User Emergency Location
      description: |
        Updates a personal emergency response location by the current user or admin.
      operationId: updateExtensionEmergencyLocation
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '../common/common-params-oaf.yml#/components/parameters/ExtensionId'
        - $ref: '#/components/parameters/EmergencyLocationId'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmergencyLocationRequestResource'
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyLocationResponseResource'
      
      x-docs-level: Public
      x-app-permission: "EditAccounts"
      x-user-permission: "EmergencyFramework"
      x-throttling-group: "Light"
      x-feature: EmergencyFramework or NewEmergencyCallingFramework
    delete:
      tags:
        - Automatic Location Updates
      summary: Delete User Emergency Location
      description: |
        Deletes a personal emergency response location by ID by
        the current user or admin. Multiple personal emergency response
        locations can be deleted by single API call.
      operationId: deleteExtensionEmergencyLocation
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '../common/common-params-oaf.yml#/components/parameters/ExtensionId'
        - $ref: '#/components/parameters/EmergencyLocationId'
        - name: validateOnly
          in: query
          description: |
            Flag indicating that only validation of Emergency Response Locations
            to be deleted is required
          required: false
          schema:
            type: boolean
      responses:
        "204":
          description: No content
      
      x-docs-level: Public
      x-app-permission: "EditAccounts"
      x-feature: EmergencyFramework or NewEmergencyCallingFramework
      x-user-permission: "EmergencyFramework"
      x-throttling-group: "Heavy"
    get:
      tags:
        - Automatic Location Updates
      summary: Get User Emergency Location
      description: Returns a personal emergency response location for the current user.
      operationId: getExtensionEmergencyLocation
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '../common/common-params-oaf.yml#/components/parameters/ExtensionId'
        - $ref: '#/components/parameters/EmergencyLocationId'
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/CommonEmergencyLocationResource'
      
      x-app-permission: "ReadAccounts"
      x-throttling-group: "Light"
      x-availability: "High"
      x-docs-level: Public

  /restapi/v1.0/account/{accountId}/emergency-calling:
    get:
      tags:
        - Automatic Location Updates
      summary: Get Emergency Calling Configuration
      description: Returns emergency calling configuration.
      operationId: getEmergencyCallingConfiguration
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
      responses:
        "200":
          description: Emergency Calling Configuration
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EmergencyCallingConfigInfo'
      
      x-app-permission: "ReadAccounts"
      x-user-permission: "ReadCompanyInfo"
      x-throttling-group: "Light"
      x-availability: "High"
      x-feature: ReadCompanyInfo
      x-docs-level: Internal

  /restapi/v1.0/account/{accountId}/emergency-calling/activate-emergency-locations:
    post:
      tags:
        - Automatic Location Updates
      description: |
        Allows to activate Emergency Response Locations feature for the current
        account.
      summary: Activate Emergency Locations
      operationId: activateEmergencyLocations
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
      responses:
        "202":
          description: Accepted - Async task for adding ELINs has been created
        "204":
          description: No content - Feature has been activated
      
      x-app-permission: "EditAccounts"
      x-user-permission: "EditEmergencyLocations"
      x-throttling-group: "Heavy"
      x-feature: EditEmergencyLocations

  /restapi/v1.0/account/{accountId}/emergency-calling/locations/{locationId}:
    get:
      tags:
        - Automatic Location Updates
      summary: Get Emergency Address
      description: Returns an emergency address by an emergency response location ID. Available for regular users.
      operationId: readEmergencyAddressByErlId
      parameters:
        - $ref: '../common/common-params-oaf.yml#/components/parameters/AccountId'
        - $ref: '#/components/parameters/EmergencyLocationId'
      responses:
        "200":
          description: Successful response
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EmergencyAddressResource'
      
      x-app-permission: "EditAccounts"
      x-throttling-group: "Medium"
      x-feature: AdditionalEmergencyRoutingOptions AND NewEmergencyCallingFramework
      x-docs-level: Internal

  /restapi/v1.0/address-validation/emergency/validate:
    post:
      tags:
        - Automatic Location Updates
      summary: Validate Emergency Address
      description: Validates address in external Emergency Address Service.
      operationId: validateEmergencyAddress
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ValidateEmergencyAddressRequest'
        required: true
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidateEmergencyAddress'
      
      x-app-permission: "EditAccounts"
      x-throttling-group: "Medium"
      x-internal-api: false
      x-docs-level: Internal
      x-availability: "High"

  /restapi/v1.0/dictionary/address-formats:
    get:
      tags:
        - Automatic Location Updates
      summary: List Address Formats for Emergency Locations
      description: Returns available address formats for ERLs.
      operationId: listAddressFormatsErl
      parameters:
      - name: countryId
        in: query
        description: |
          Internal identifier of a country. If not specified, the response
          is returned for all countries
        schema:
          type: string
      - name: addressType
        in: query
        description: |
          Address format type for filtration
        schema:
          type: string
          enum:
            - Emergency
            - Shipping
      responses:
        "200":
          description: Emergency address formats
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AddressFormatResourceCollection'
      x-throttling-group: "Light"
      x-availability: "High"
      x-docs-level: Internal
      x-auth-context-type: [User, Brand]

  /restapi/v1.0/dictionary/address-formats/{addressFormatId}:
    get:
      tags:
        - Automatic Location Updates
      summary: Get Address Format
      description: Returns address format by ID.
      operationId: getAddressFormatById
      parameters:
        - name: addressFormatId
          in: path
          required: true
          description: |
            Internal identifier of an address format
          schema:
            type: string
      responses:
        "200":
          description: Emergency address format
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AddressFormatResource'
      x-throttling-group: "Light"
      x-availability: "High"
      x-docs-level: Internal
      x-auth-context-type: [ User, Brand ]

components:
  parameters:

    EmergencyLocationId:
      name: locationId
      in: path
      description: Internal identifier of an emergency response location
      required: true
      schema:
        type: string

    SiteIdQuery:
      name: siteId
      in: query
      description: |
        Internal identifier of a site for filtering. To indicate company main
        site `main-site` value should be specified. Supported only if multi-site feature
        is enabled for the account. Multiple values are supported.
      style: form
      explode: true
      schema:
        type: array
        items:
          type: string

  schemas:

    AddressFormatResourceCollection:
      type: object
      required:
        - records
      properties:
        records:
          type: array
          items:
            $ref: '#/components/schemas/AddressFormatResource'

    AddressFormatResource:
      type: object
      required:
        - id
        - validationVersion
        - applicableToAddressTypes
        - country
        - fields
        - primary
        - allowed
      properties:
        id:
          type: string
          description: |
            Internal identifier of an address format
        validationVersion:
          type: string
          description: |
            Defines which validation provider will be used for address normalisation. 
            (V1-SmartyStreets,V2-Informatica,V3-DASH,V4-DLR)
          enum:
            - None
            - V1
            - V2
            - V3
            - V4
        applicableToAddressTypes:
          type: array
          description: List of address types
          items:
            $ref: '#/components/schemas/LocationType'
        country:
          $ref: '#/components/schemas/CountryInfoResource'
        fields:
          type: array
          description: List of address types
          items:
            $ref: '#/components/schemas/AddressFormatField'
        dependencies:
          type: array
          minItems: 1
          description: |
            An array of dependencies which override certain format validation policies. 
            Is utilised to create a validation rule of two address format fields.
          items:
            $ref: '#/components/schemas/AddressFormatDependencyResource'
        primary:
          type: boolean
          description: |
            Is the format primary
        allowed:
          type: boolean
          description: |
            Is the format deprecated

    AddressFormatDependencyResource:
      type: object
      required:
        - fieldId
        - dependentFieldId
        - logicalOperator
        - type
      properties:
        fieldId:
          type: string
          description: The id of the primary address format field
        dependentFieldId:
          type: string
          description: The id of the dependent address format field
        logicalOperator:
          type: string
          enum:
            - OR
            - AND
          description: Logical operator to apply to the logic of handling dependencies
        type:
          type: string
          enum:
            - MandatoryGroup
          description: Defines which address format validation policy is being overridden

    LocationType:
      type: string
      enum:
        - Emergency
        - Shipping
      description: |
        Address types (Emergency or Shipping)

    CountryInfoResource:
      type: object
      properties:
        id:
          type: string
          description: Internal identifier of a country
        name:
          type: string
          description: Official name of a country
        isoCode:
          $ref: '../common/common-schemas-oaf.yml#/components/schemas/CountryIsoCode'
        addressFormatImposed:
          type: boolean
          description: Is validation against address formats required

    AddressFormatField:
      type: object
      required:
        - id
        - name
        - type
        - metadata
      properties:
        id:
          type: string
          description: Internal identifier of a field
        name:
          type: string
          description: Name of a field
        type:
          type: string
          enum:
            - string
            - integer
            - number
            - boolean
          description: Type of field
        skipValidation:
          type: boolean
          description: |
            Is utilised to skip validation of a certain address field
        metadata:
          $ref: '#/components/schemas/AddressFormatMetadata'
        options:
          type: array
          items:
            $ref: '#/components/schemas/AddressFormatOption'

    AddressFormatMetadata:
      type: object
      properties:
        mandatory:
          type: boolean
        regexp:
          type: string
          description: |
            Java regexp for format field validation
        maxLength:
          type: integer
          format: int32
          minimum: 0
        order:
          type: integer
          format: int32
          minimum: 0
        defaultValue:
          type: string
          description: Default value of a field
        hidden:
          type: boolean
          description: Is the field invisible in the UI

    AddressFormatOption:
      type: object
      properties:
        label:
          type: string
          description: |
            Name of of 'key' parameter
        key:
          type: string
          description: |
            Required value of a field

    EmergencyLocationsResource:
      type: object
      properties:
        uri: 
          type: string
          description: Link to an emergency locations resource
        records:
          type: array
          items:
            $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/CommonEmergencyLocationResource'
        paging:
          $ref: '#/components/schemas/EmergencyLocationsPaging'
        navigation:
              $ref: '../common/pagination-oaf.yml#/components/schemas/PageNavigationModel'

    EmergencyLocationRequestResource:
      type: object
      properties:
        address:
          $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyAddressResourceRequest'
        name:
          type: string
          description: Emergency response location name
        site:
          $ref: '../common/common-schemas-oaf.yml#/components/schemas/SiteBasicInfo'
        addressFormatId:
          type: string
          description: Address format ID
        visibility:
          type: string
          description: |
            Visibility of an emergency response location. If `Private`
            is set, then a location is visible only for restricted number of users,
            specified in `owners` array
          default: Public
          enum:
          #- Private
          - Public
        #owners:
          #type: array
          #description: List of private location owners
          #items:
            #$ref: '#/components/schemas/LocationOwnerInfo'
        trusted:
          allOf:
            - $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/TrustedFlag'
            - default: false

    EmergencyAddressResource:
      type: object
      properties:
        id:
          type: string
          description: Internal identifier of an emergency response location
        addressFormatId:
          type: string
          description: Address format ID
        addressFormatStatus:
          $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/AddressFormatStatus'
        address:
          $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyLocationAddressResource'
        addressStatus:
          $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyAddressStatus'
        trusted:
          $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/TrustedFlag'

    EmergencyLocationUsageStatus:
      type: string
      enum:
        - Active
        - Inactive

    ValidateEmergencyAddressRequest:
      type: object
      properties:
        addressFormatId:
          type: string
          description: Address format ID
        address:
          $ref: '../common/emergency-addresses-oaf.yml#/components/schemas/EmergencyAddressResourceRequest'
        phoneCountryId:
          type: string
          description: |
            Internal identifier of a country the phone number belongs to.
            Specifies if address is out of country

    ValidateEmergencyAddress:
      type: object
      properties:
        status:
          type: string
          description: Status of emergency address upon validation
          enum:
          - Valid
          - Ambiguous
          - Invalid
          - OutOfCountryForbidden
        reason:
          type: string
          description: Reason for validation failure
          example: "Only local emergency address is allowed for the selected country"
        addressFormatId:
          type: string
          description: Address format ID
        suggestedAddresses:
          type: array
          description: |
            List of addresses suggested by Emergency Address
            Service provider
          items:
            $ref: '#/components/schemas/ValidateEmergencyAddressInfoResponse'

    ValidateEmergencyAddressInfoResponse:
      type: object
      properties:
        customerName:
          type: string
          description: Customer name
        country:
          type: string
          description: Country name
        countryName:
          type: string
          description: Full name of a country
        countryId:
          type: string
          description: Internal identifier of a country
        state:
          type: string
          description: |
            State/Province name. Mandatory for the USA, the UK and Canada
        stateId:
          type: string
          description: Internal identifier of a state
        stateName:
          type: string
          description: Full name of a state
        city:
          type: string
          description: City name
        street:
          type: string
          description: First line address
        street2:
          type: string
          description: |
            Second line address (apartment, suite, unit, building, floor,
            etc.)
        zip:
          type: string
          description: Postal (Zip) code
        outOfCountry:
          type: boolean
          description: |
            Specifies if emergency address is out of country
      additionalProperties:
        description: |
          Any address fields are accepted but within the boundaries of the address format (specific or default for a certain country)
        type: string

    EmergencyLocationsPaging:
      required:
        - page
        - totalPages
        - perPage
        - totalElements
        - pageStart
        - pageEnd
      type: object
      properties:
        page:
          type: integer
          format: int32
        totalPages:
          type: integer
          format: int32
        perPage:
          type: integer
          format: int32
        totalElements:
          type: integer
          format: int32
        pageStart:
          type: integer
          format: int32
        pageEnd:
          type: integer
          format: int32

    EmergencyCallingConfigInfo:
      type: object
      properties:
        softPhoneAutoLocationUpdate:
          $ref: '#/components/schemas/SoftPhoneLocationAutoUpdateInfo'
        hardPhoneAutoLocationUpdate:
          $ref: '#/components/schemas/HardPhoneLocationAutoUpdateInfo'
        emergencyLocations:
          $ref: '#/components/schemas/ERLFeatureInfo'

    SoftPhoneLocationAutoUpdateInfo:
      type: object
      properties:
        status:
          type: string
          description: |
            Feature (Automatic Location Updates) activation status for soft phones
          enum:
          - Active
          - Inactive
          - Unavailable

    HardPhoneLocationAutoUpdateInfo:
      type: object
      properties:
        status:
          type: string
          description: |
            Feature (Automatic Location Updates) activation status for desk phones
          enum:
          - Active
          - Inactive
          - Unavailable

    GetLocationDeletionMultiResponse:
      type: object
      properties:
        deletion:
          type: string
